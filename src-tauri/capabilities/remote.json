{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-site",
  "description": "本站页面可调用本机命令，并监听目录变化",
  "windows": ["main"],
  "webviews": ["site"],
  "remote": {
    "urls": [
      "https://zhange.space/*",
      "https://*.zhange.space/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  },
  "permissions": ["core:event:allow-listen", "core:event:allow-emit"]
}
